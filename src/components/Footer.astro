---
const inceptionYear = 2025;
const commitHash = import.meta.env.VITE_GIT_COMMIT ?? "dev";
const gitUrl = `https://git.lscythe.dev/lscythe/website/commit/${commitHash}`;
---

<footer>
    <div class="top">
        <span>&COPY; <span id="year-display" data-inception={inceptionYear}>{inceptionYear}</span></span>
        <span><a href="/">lscythe.dev</a></span>
        <span>-</span>
        <span><a href="/privacy-policy">privacy policy</a></span>
        <span>-</span>
        <span><a href="/LICENSE">license</a></span>
    </div>
    <div class="bottom">
        <span>
            built with &lt;3 on commit: <a href={gitUrl}>{commitHash}</a>
        </span>
        <p>
            theme [
            <select name="theme" id="theme-select">
                <option value="system">system</option>
                <option value="dark">moon</option>
                <option value="light">dawn</option>
            </select>
            ] by <a href="https://rosepinetheme.com/">Rosé Pine</a>
        </p>
    </div>
</footer>

<style>
    footer {
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        padding: var(--space-lg);
        max-width: var(--max-content-width);
        margin: 0 auto;
        border-top: 3px solid var(--color-overlay);
    }

    .top {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
    }

    .bottom {
        margin: var(--space-md) 0 0;
    }

    a {
        color: var(--color-iris);
    }

    select {
        background: none;
        border: none;
        padding: 0;
        margin: 0 -0.5rem;
        font-family: inherit;
        font-size: inherit;
    }
</style>

<script is:inline>
    // Dynamic year display
    const yearEl = document.querySelector("#year-display");
    if (yearEl) {
        const inception = parseInt(yearEl.dataset.inception);
        const current = new Date().getFullYear();
        yearEl.textContent = current > inception ? `${inception} - ${current}` : `${inception}`;
    }

    // Theme selector
    const select = document.querySelector("#theme-select");
    if (!select) throw new Error("Theme selector missing");
    select.value = localStorage.getItem("theme") || "system";

    const set_theme = (theme) => {
        document.documentElement.setAttribute("theme", theme);
        localStorage.setItem("theme", theme);
    };

    select.onchange = () => set_theme(select.value);
</script>
