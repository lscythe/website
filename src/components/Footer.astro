---
const currentYear = new Date().getFullYear();
const commitHash = import.meta.env.VITE_GIT_COMMIT ?? "dev";
const gitUrl = `https://git.lscythe.dev/lscythe/website/commit/${commitHash}`;
---

<footer>
    <div class="top">
        <span>&COPY; {currentYear}</span>
        <span><a href="/">lscythe.dev</a></span>
        <span>-</span>
        <span><a href="/privacy-policy">privacy policy</a></span>
        <span>-</span>
        <span><a href="/LICENSE">license</a></span>
    </div>
    <div class="bottom">
        <span>
            built with &lt;3 on commit: <a href={gitUrl}>{commitHash}</a>
        </span>
        <p>theme by <a href="https://rosepinetheme.com/"></a>Rosé Pine</p>
    </div>
</footer>

<style>
    footer {
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        padding: var(--space-lg);
    }

    .bottom {
        margin: var(--space-md) 0 0;
    }

    a {
        color: var(--color-iris);
    }
</style>
