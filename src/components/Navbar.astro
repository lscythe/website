---
import Menu from "../assets/menu.svg";

const { title } = Astro.props;

const links = [
    { label: "/about", href: "/about" },
    { label: "/blog", href: "/blog" },
    { label: "/projects", href: "/projects" },
];

const pathSegment = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbSegment = pathSegment.map((segment, index, orig) => {
    return {
        label: decodeURIComponent(segment),
        href: `/${orig.slice(0, index + 1).join("/")}`,
        index,
    };
});
---

<header class="navbar">
    <span class="label">
        <a href="/">~</a><span class="separator">/</span>
        {
            title ??
                breadcrumbSegment.map((segment) => (
                    <a>
                        {segment.index === 0 ? null : (
                            <span class="separator">/</span>
                        )}
                        <span class="crumb">
                            <a href={segment.href}>{segment.label}</a>
                        </span>
                    </a>
                ))
        }
    </span>
    <button
        popovertarget="navbar-mobile"
        title="menu"
        aria-label="toggle navigation"
    >
        <Menu />
    </button>
    <nav popover id="navbar-mobile">
        <div class="links">
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
    </nav>
    <nav class="navbar-items">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
</header>

<style>
    header {
        display: flex;
        position: fixed;
        max-width: var(--max-content-width);
        justify-content: space-between;
        width: 100%;
        padding: var(--space-lg);
        z-index: 2;
        transition: transform 0.2s ease;
        border-bottom: 3px solid var(--color-overlay);
        background: var(--color-base);

        &[scroll-direction="down"] {
            transform: translateY(-100%);
            pointer-events: none;
        }
    }

    .label {
        display: flex;
        align-items: center;
        white-space: nowrap;
        overflow: hidden;
        .crumb {
            display: inline-flex;
        }
        .separator {
            padding: 0 var(--space-sm);
        }
        a {
            text-decoration: none;
        }
    }

    button {
        all: unset;
        cursor: pointer;
        color: var(--color-text);

        &:hover {
            color: var(--color-highlight-mid);
        }
    }

    #navbar-mobile[popover] {
        top: calc(2rlh + 1lh);
        background-color: var(--color-base);
        border: none;
        width: 100%;
        max-width: var(--max-content-width);
        margin: 0 auto;
    }

    .links {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        width: 100%;
        padding: var(--space-md) var(--space-lg);
        gap: var(--space-md);
    }

    #navbar-mobile:popover-open {
        display: flex;
        border-bottom: 1px solid var(--color-surface);
    }

    .navbar-items {
        display: none;
    }

    @media (width >= 768px) {
        button[popovertarget="navbar-mobile"],
        #navbar-mobile[popover] {
            display: none;
        }

        .navbar-items {
            display: flex;
            gap: var(--space-lg);
        }
    }
</style>

<script>
    const header = document.querySelector<HTMLElement>(".navbar");
    const mobileMenu = document.querySelector<HTMLElement>("#navbar-mobile");
    let lastScrollTop = 0;

    window.addEventListener(
        "scroll",
        () => {
            const scrollTop =
                window.scrollY || document.documentElement.scrollTop;
            const dir = scrollTop > lastScrollTop ? "down" : "up";
            if (Math.abs(scrollTop - lastScrollTop) > 3) {
                header?.setAttribute("scroll-direction", dir);
            }
            lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
            mobileMenu?.hidePopover();
        },
        { passive: true },
    );
</script>
